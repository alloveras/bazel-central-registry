load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Header-only target; consumed by //kernel-lib to avoid a dep cycle
# (kernel-lib/raid56.c includes kernel-shared headers, while kernel-shared
# depends on kernel-lib for its implementations).
cc_library(
    name = "headers",
    hdrs = glob([
        "*.h",
        "uapi/**/*.h",
    ]),
    # ctree.h includes "crypto/crc32c.h", so crypto headers must be visible to
    # consumers of this header-only target (e.g. //kernel-lib:kernel-lib).
    deps = ["//crypto:headers"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "kernel-shared",
    srcs = glob(["*.c"]),
    hdrs = glob([
        "*.h",
        "uapi/**/*.h",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "//include",
        # //common:extent_cache provides cache_tree_init (extent-cache.c) and
        # rb_insert / rb_search / rb_free_nodes (rbtree-utils.c).  Making this
        # an explicit dep — rather than relying on the transitive //common dep —
        # puts extent_cache.a *after* kernel-shared.a in the link order, so
        # kernel-shared objects create the demand for cache_tree_init and
        # extent_cache.a satisfies it.  This removes alwayslink from //check:check_lib.
        "//common:extent_cache",
        "//crypto",
        "//kernel-lib",
        "//mkfs:headers",
        "@libuuid//:libuuid",
        "@zlib//:zlib",
        "@zstd//:zstd",
        # "@liblzo2//:liblzo2",  # TODO: not yet in the BCR
    ],
)
