        "//kernel-lib",
        "//kernel-shared",
        "//libbtrfsutil",
        # "@libext2fs//:libext2fs",  # TODO: e2fsprogs not yet in the BCR
        # "@libcom_err//:libcom_err",  # TODO: e2fsprogs not yet in the BCR
    ],
