load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Header-only target; allows //cmds to include "mkfs/common.h" without
# creating a //mkfs ↔ //cmds cycle.
cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "mkfs_lib",
    srcs = [
        "common.c",
        "rootdir.c",
    ],
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
    deps = [
        "//include",
        "//common",
        "//kernel-lib",
        "//kernel-shared",
        "//libbtrfsutil",
    ],
)

cc_binary(
    name = "mkfs.btrfs",
    srcs = ["main.c"],
    visibility = ["//visibility:public"],
    deps = [
        ":mkfs_lib",
        "//check:check_lib",
        "//cmds:headers",
        "//include",
        "//common",
        "//kernel-lib",
        "//kernel-shared",
        "//libbtrfsutil",
    ],
)
